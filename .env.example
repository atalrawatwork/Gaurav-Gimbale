# Copy to .env.local and fill in. Never commit real secrets.

# Your deployed domain (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.gimbalphotography.in

# Contact form email (any SMTP: Gmail app-password, Brevo, Zoho, SendGrid...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Where enquiries are delivered
CONTACT_TO_EMAIL=your-email@gmail.com
